{
  "name": "labflow",
  "version": "1.0.0",
  "private": true,
  "description": "LABFLOW: lab attendance, occupancy, equipment and bookings for the Karunya CSE laboratories (Google Apps Script + Google Sheets)",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i styles/input.css -o .build/tailwind.css --minify && node scripts/build-styles.js",
    "build:vendor": "node scripts/build-vendor.js",
    "build": "npm run build:vendor && npm run build:css",
    "lint": "node scripts/check-syntax.js",
    "test": "node --test test/*.test.js",
    "sim": "node dev/scenarios.js",
    "e2e": "node test/e2e/ui.e2e.js",
    "e2e:issue": "node test/e2e/issue.e2e.js",
    "e2e:projects": "node test/e2e/projects.e2e.js",
    "e2e:openlab": "node test/e2e/openlab.e2e.js",
    "e2e:hod": "node test/e2e/hod.e2e.js",
    "e2e:reports": "node test/e2e/reports.e2e.js",
    "e2e:live": "node test/e2e/live.e2e.js",
    "e2e:autoclose": "node test/e2e/autoclose.e2e.js",
    "e2e:work": "node test/e2e/work.e2e.js",
    "e2e:board": "node test/e2e/board.e2e.js",
    "dev": "node dev/server.js",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@noble/curves": "^1.9.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.48.2",
    "qrcode-generator": "^2.0.4",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=18"
  }
}
